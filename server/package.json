{
  "name": "@cornicione/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node build/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "seed": "tsx src/seeds/index.ts",
    "migration:create": "tsx ../node_modules/typeorm/cli.js migration:create ./migrations/migration",
    "migration:run": "tsx ../node_modules/typeorm/cli.js migration:run -d src/config/db/db.config.ts",
    "migration:revert": "tsx ../node_modules/typeorm/cli.js migration:revert -d src/config/db/db.config.ts",
    "db:setup": "npm run migration:run && npm run seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.0",
    "qs": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.24.0",
    "typeorm": "^0.3.31",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.20",
    "@types/pg": "^8.21.0",
    "@types/qs": "^6.9.16",
    "eslint": "^9.39.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
