'use client';

import Styles from '@components/layout/header/Header.style';
import NavDrawer from '@components/layout/nav-drawer/NavDrawer';
import { LEAD_SECTION_ANCHOR } from '@components/home/home-lead-section/lead-select.util';
import AppLink from '@components/shared/app-link/AppLink';
import NavLink from '@components/shared/nav-link/NavLink';
import MenuIcon from '@mui/icons-material/Menu';
import { AppBar, Box, Button, IconButton, Toolbar } from '@mui/material';
import { SITE } from '@shared/consts/site.const';
import { Route } from '@shared/enums/route.enum';
import { useState, type FC } from 'react';

const HEADER_LINKS = [
  { href: Route.PrivateEvents, label: 'אירועים פרטיים' },
  { href: Route.Business, label: 'אירועי חברה' },
  { href: '/#pillars', label: 'פופ-אפים' },
  { href: '/#story', label: 'הסיפור והבצק' },
  { href: '/#menu-preview', label: 'תפריט לדוגמה' },
];

const Header: FC = () => {
  const [isNavOpen, setIsNavOpen] = useState(false);

  return (
    <AppBar position="fixed" elevation={0} sx={Styles.appBar}>
      <Toolbar sx={Styles.toolbar} disableGutters>
        <AppLink href={Route.Home} sx={Styles.brand}>
          {SITE.name.toUpperCase()}
        </AppLink>
        <Box component="nav" sx={Styles.nav}>
          {HEADER_LINKS.map((link) => (
            <NavLink key={link.label} href={link.href} label={link.label} />
          ))}
        </Box>
        <Box sx={Styles.actions}>
          <Button
            variant="contained"
            size="small"
            href={`/#${LEAD_SECTION_ANCHOR}`}
            sx={Styles.cta}
          >
            שריינו תאריך
          </Button>
          <IconButton sx={Styles.menuButton} onClick={() => setIsNavOpen(true)} aria-label="תפריט">
            <MenuIcon fontSize="small" />
          </IconButton>
        </Box>
      </Toolbar>
      <NavDrawer isOpen={isNavOpen} onClose={() => setIsNavOpen(false)} />
    </AppBar>
  );
};

export default Header;
