'use client';

import {
  LEAD_TYPE_OPTIONS,
  LEAD_WHATSAPP_MESSAGE,
} from '@components/home/home-lead-section/HomeLeadSection.const';
import Styles from '@components/home/home-lead-section/HomeLeadSection.style';
import {
  buildMessage,
  DEFAULTS,
  formSchema,
  type FormValues,
} from '@components/home/home-lead-section/HomeLeadSection.util';
import {
  LEAD_SECTION_ANCHOR,
  LEAD_TYPE_SELECT_EVENT,
} from '@components/home/home-lead-section/lead-select.util';
import LeadFields from '@components/home/home-lead-section/LeadFields';
import PageContainer from '@components/shared/page-container/PageContainer';
import { zodResolver } from '@hookform/resolvers/zod';
import { Box, Button, Chip, Typography } from '@mui/material';
import { buildWhatsappLink } from '@shared/consts/site.const';
import { type LeadType } from '@shared/enums/lead-type.enum';
import { useEffect, type FC } from 'react';
import { useForm, useWatch } from 'react-hook-form';
import { useCreateLead } from '@/hooks/api/useCreateLead';

/** סקשן ההמרה — טופס לידים חכם, וואטסאפ ישיר לפי סוג הפנייה. */
const HomeLeadSection: FC = () => {
  const { mutateAsync, isPending, isSuccess, error } = useCreateLead();
  const { control, handleSubmit, reset, setValue } = useForm<FormValues>({
    resolver: zodResolver(formSchema),
    defaultValues: DEFAULTS,
  });
  const leadType = useWatch({ control, name: 'leadType' });

  useEffect(() => {
    const handler = (event: Event) => {
      setValue('leadType', (event as CustomEvent<LeadType>).detail);
    };

    window.addEventListener(LEAD_TYPE_SELECT_EVENT, handler);

    return () => window.removeEventListener(LEAD_TYPE_SELECT_EVENT, handler);
  }, [setValue]);

  const onSubmit = handleSubmit(async (values) => {
    await mutateAsync({
      leadType: values.leadType,
      fullName: values.fullName,
      phone: values.phone,
      email: '',
      businessName: '',
      message: buildMessage(values),
    });
    reset(DEFAULTS);
  });

  return (
    <Box component="section" id={LEAD_SECTION_ANCHOR} sx={Styles.section}>
      <PageContainer>
        <Box sx={Styles.grid}>
          <Box>
            <Typography variant="h2" sx={Styles.title}>
              רוצים שנגיע אליכם עם הטאבון? בואו נדבר
            </Typography>
            <Typography variant="subtitle1" sx={Styles.subtitle}>
              השאירו פרטים ונחזור אליכם בהקדם, או דברו איתנו ישירות בוואטסאפ.
            </Typography>
          </Box>
          <Box component="form" onSubmit={onSubmit} sx={[Styles.formWrapper, Styles.form]}>
            <Box sx={Styles.chips} role="radiogroup" aria-label="סוג הפנייה">
              {LEAD_TYPE_OPTIONS.map((option) => (
                <Chip
                  key={option.value}
                  label={option.label}
                  role="radio"
                  aria-checked={leadType === option.value}
                  color={leadType === option.value ? 'primary' : 'default'}
                  variant={leadType === option.value ? 'filled' : 'outlined'}
                  onClick={() => setValue('leadType', option.value)}
                />
              ))}
            </Box>
            <LeadFields control={control} />
            <Box sx={Styles.actions}>
              <Button type="submit" variant="contained" disabled={isPending}>
                שלחו פרטים ונחזור אליכם
              </Button>
              <Button
                variant="outlined"
                href={buildWhatsappLink(LEAD_WHATSAPP_MESSAGE[leadType])}
                target="_blank"
                rel="noopener noreferrer"
              >
                דברו איתנו ישירות בוואטסאפ
              </Button>
            </Box>
            {isSuccess ? <Typography>הפנייה נשלחה — נחזור אליכם בקרוב.</Typography> : null}
            {error ? <Typography color="error">{error.message}</Typography> : null}
          </Box>
        </Box>
      </PageContainer>
    </Box>
  );
};

export default HomeLeadSection;
